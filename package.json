{
  "name": "sibyl-ds",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo Sibyl Design System — tokens + composants partagés, trois sites (MD, UI, Audit) sur la même stack Next.js.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sibyl/site",
    "build": "npm run build --workspaces --if-present",
    "tokens:build": "npm run build --workspace @sibyl/tokens",
    "plugin": "node tools/plugin/publie.js",
    "plugin:build": "node tools/plugin/build-plugin.js"
  },
  "engines": {
    "node": ">=18.18"
  }
}
